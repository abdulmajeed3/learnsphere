# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/learnsphere_dev"
# JWT
JWT_ACCESS_SECRET="change-this-access-secret-in-production-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Cookie
COOKIE_SECRET="change-this-cookie-secret-in-production-min-32-chars"
